{
  // BUILD config. `rootDir` and `references` below are wrong for typechecking
  // this package (TS6059 / TS6306), because the bridge imports the cli through
  // relative paths (../../cli/src/...) that sit outside ./src. `bun run
  // typecheck` therefore uses tsconfig.typecheck.json, which extends this file
  // and drops both. Keep them here — `rootDir` governs emit layout.
  "compilerOptions": {
    // ES2023 so cli sources shared via those relative imports typecheck
    // (e.g. Array.prototype.findLast). Node >=18 and Bun both support it.
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    // No rootDir: routing-middleware.ts imports 13 modules from ../cli/src,
    // outside ./src. With rootDir:./src those cross-imports raise TS6059 x155.
    // The build is `bun build src/index.ts` (bundler), which never consults
    // rootDir/outDir — dropping rootDir only removes the false containment.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
  // No project reference to ../cli (#981): packages/cli is not composite, so the
  // reference raised TS6306; making cli composite would emit declaration outputs
  // and force CI build-order coupling. The bridge typechecks the cli sources it
  // imports directly (they enter the program through the import graph).
}
